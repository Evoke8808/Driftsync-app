{
  "name": "skillsetu",
  "version": "1.0.0",
  "description": "SkillSetu - AI shouldn't decide who gets left behind",
  "repository": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sap-ai-sdk/orchestration": "^2",
    "@sap/cds": "^10",
    "express": "^4",
    "hdb": "^0.19.12",
    "zod": "^4.6.7",
    "@cap-js/sqlite": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "sap:check": "node mcp/sap/check.js",
    "sap:hana-setup": "node mcp/sap/hana-setup.js",
    "build": "npm install && cds deploy --to sqlite:db.sqlite"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "SFRecruiting": {
        "[production]": {
          "kind": "odata-v2",
          "model": "srv/external/SFRecruiting",
          "credentials": {
            "destination": "SFSF_RECRUITING",
            "path": "/odata/v2"
          }
        }
      }
    }
  },
  "engines": {
    "node": ">=20"
  }
}
